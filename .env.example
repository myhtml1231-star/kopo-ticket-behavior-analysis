# Fill these values locally; do not share passwords or API keys in chat.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_TOPIC=ticket-demo/events
ELASTIC_URL=
ELASTIC_API_KEY=
KIBANA_URL=
# Optional saved Discover log view for the presentation
KIBANA_LOG_URL=

# Only record CAPTCHA display-to-completion duration
CAPTCHA_ONLY_LOGGING=true
KIBANA_CAPTCHA_URL=

# Optional Discover view for scenario 2
KIBANA_RETRY_URL=

# Persistent MQTT worker identity; change to start a new client counter.
MQTT_WORKER_CLIENT_ID=ticket-indexer
